DRIVER=~fastapi
HOST=0.0.0.0
PORT=9012
COMMAND_START=["/"]

# ---- Remote Browser Configuration (choose ONE) ----

# Option 1: CDP (Chrome DevTools Protocol) - Chromium only
# Matches the docker-compose.yml chromium service
RENDER={"provider":"playwright","startup":"probe","provider_config":{"engine":"chromium","connect_cdp":{"endpoint":"http://localhost:9222"}}}

# Option 2: WebSocket - supports Chromium / Firefox / WebKit
# Replace the RENDER line above with:
# RENDER={"provider":"playwright","startup":"probe","provider_config":{"engine":"chromium","connect_ws":{"endpoint":"ws://localhost:3000"}}}
