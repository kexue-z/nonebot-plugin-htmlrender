DRIVER=~fastapi
HOST=0.0.0.0
PORT=9012
COMMAND_START=["/"]
RENDER_BACKEND=playwright

# ---- Remote Browser Configuration (choose ONE) ----

# Option 1: CDP (Chrome DevTools Protocol) - Chromium only
# Matches the docker-compose.yml chromium service
RENDER_PLAYWRIGHT__CONNECT_CDP__ENDPOINT=http://localhost:9222

# Option 2: WebSocket - supports Chromium / Firefox / WebKit
# RENDER_PLAYWRIGHT__CONNECT_WS__ENDPOINT=ws://localhost:3000
