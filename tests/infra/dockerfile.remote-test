# Lightweight render image for remote Playwright integration smoke tests.
ARG PYTHON_BASE_IMAGE=docker.1ms.run/library/python:3.12-slim-bookworm
ARG PLAYWRIGHT_CLIENT_VERSION=1.56.0
FROM ${PYTHON_BASE_IMAGE}

ENV TZ=Asia/Shanghai \
    DEBIAN_FRONTEND=noninteractive \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/venv

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates fontconfig \
    && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir uv

WORKDIR /tmp/remote-smoke
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-install-project --group dev --group test --extra filehost \
    && /venv/bin/python -m pip install --no-deps playwright==${PLAYWRIGHT_CLIENT_VERSION}

WORKDIR /app
